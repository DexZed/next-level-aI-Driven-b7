              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json().data;\r",
                  "if (res.paymentIntentId || res.bookingId) {\r",
                  "    pm.environment.set(\"paymentIntentId\", res.paymentIntentId);\r",
                  "    pm.environment.set(\"bookingId\", res.bookingId);\r",
                  "\r",
                  "} else {\r",
                  "    console.log(\"No access paymentIntentId found\");\r",
                  "}"
                ],
